#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int x, y, z;
        cin >> x >> y >> z;
        int times = x * y;
        int breaks = (x - 1) / 3;
        int total = times + (breaks * z);
        cout << total << endl;

    }
}