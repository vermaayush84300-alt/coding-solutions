#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
   int t;
   cin>>t;
   while(t--){
       int n;
       cin>>n;
       string a,b;
       cin>>a>>b;
       int countA = count(a.begin(), a.end(),'1');
       int countB = count(b.begin(), b.end() ,'1');
       if((countA%2)==(countB%2)){
           cout<<"yes"<<endl;
       }
       else{
           cout<<"no"<<endl;
       }
   }
}
