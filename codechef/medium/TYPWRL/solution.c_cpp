#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
 int t;
 cin>>t;
 while(t--){
     int n,m;
     cin>>n>>m;
     string s,l;
     cin>>s>>l;
     unordered_set<char>left(l.begin(),l.end());
     int mx =0 , curr=0;
     char prev = '#';
     for (char c:s){
         char hand = (left.count(c) ? 'l':'r');
         if(hand == prev){
             curr++;
         }
         else{
             curr=1;
             prev=hand;
         }
         mx = max(mx,curr);
     }
     cout<<mx<<endl;
 }
}
