#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
 int t;
 cin>>t;
 while(t--){
     int n, k;
     cin>>n>>k;
     string s;
     cin>>s;
     int groups=1;
     for(int i=1; i<n ; i++){
         if(s[i]!=s[i-1]){
             groups++;
         }
     }
     if(groups <= k){
         cout<<"yes"<<endl;
     }
     else{
         cout<<"no"<<endl;
     }
     
 }
 return 0;
}
