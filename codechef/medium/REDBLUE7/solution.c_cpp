#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
  int t;
  cin>>t;
  while(t--){
      int n;
      cin>>n;
      vector<long long>a(n);
      long long total=0;
      for(long long &x:a){
          cin>>x;
          total+=x;
      }
      sort(a.rbegin(),a.rend());
      int k=n/2;
      long long sr=0,cr=0,sb=0,cb=0;
      for(int i=0 ;i<k; i++){
          sr +=a[i];
          cr++;
      }
      for(int i=k ; i<n ; i++){
          sb+=a[i];
          cb++;
      }
      long long ans = sr*cb+sb*cr;
      if(n%2==1){
          sr+=a[k];
          cr++;
          sb-=a[k];
          cb--;
          ans = max(ans, sr*cb+sb*cr);
      }
      cout<<ans<<endl;
  }
  return 0;
}
