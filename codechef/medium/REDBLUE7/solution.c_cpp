#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
  int t;
  cin>>t;
  while(t--){
      int n;
      cin>>n;
      vector<long long>a(n);
      long long total=0;
      for(long long &x:a){
          cin>>x;
          total+=x;
      }
      sort(a.rbegin(),a.rend());
      int k=n/2;
      long long sum=0;
      for(int i=0 ;i<k; i++){
          sum +=a[i];
      }
      long long ans = total*k;
      if(n%2==1){
          ans+=sum;
      }
    
       cout<<ans<<endl;
  }
  return 0;
}
