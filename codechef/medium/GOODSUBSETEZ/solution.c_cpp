#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
 int T;
 cin>>T;
 while(T--)
{ 
    int n;
    cin>>n;
    map<int , int>m;
 for(int i=0; i<n ; i++){
     int x;
     cin>>x;
     int bit =0;
     while(x>1){
         x>>=1;
         bit++;
     }
     m[bit]++;
 }
    int ans =0;
    for(auto it:m){
        ans = max(ans,it.second);
        
    }
    cout<<ans<<endl;
}
}
