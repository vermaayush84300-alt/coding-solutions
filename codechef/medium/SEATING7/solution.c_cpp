#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,m,k;
        cin>>n>>m>>k;
       vector<int>occ(n+1,0);
        for(int i=0; i<m; i++){
            int x;
            cin>>x;
            occ[x] = 1;
        }
        int count =0;
        for(int j=1; j<=n ; j++){
            if(occ[j]==0){
                cout<<j;
                count++;
                if(count==k){
                    break;
                }
               cout<<" ";
            }
            
        }
        cout<<endl;
    }
}
