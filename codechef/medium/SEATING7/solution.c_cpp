#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;
    cin>>t;
    while(t--){
        int n,m,k;
        cin>>n>>m>>k;
        vector<bool>occ(n+1,false);
        for(int i=0; i<m; i++){
            int x;
            cin>>x;
            occ[x] = true;
        }
        int count =0;
        for(int j=1; j<=n && count<k ; j++){
            if(!occ[j]){
                cout<<j;
                count++;
                if(count<k)
                cout<<"";
            }
            
        }
        cout<<endl;
    }
}
