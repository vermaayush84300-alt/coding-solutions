#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int T;
cin>>T;
while(T--){
    int N,K;
    cin>>N>>K;
    vector<int>arr(N);
    for(int i=0 ;i<N; i++){
        cin>>arr[i];
    }
    
    int len = N-K;
    int sum =0;
    for(int i=0 ; i<len;i++){
        sum+=arr[i];
    }
    
    int maximum = sum;
    for(int i = len ; i<N ; i++){
        sum += arr[i];
        sum -= arr[i-len];
        maximum = max(maximum , sum);
        
    }
    cout<<maximum<<endl;
}
}
