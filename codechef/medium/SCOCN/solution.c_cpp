#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int n;
cin>>n;
vector<int>A(n);
for(int i=0 ; i<n ; i++){
    cin>>A[i];
}
int x;
cin>>x;

int count =0;
for(int i=0; i<n ; i++){
   if(A[i]==x){
       count++;
       
       if(count==0){
           cout<<i<<endl;
           return 0;
       }
   }
 
}
 if(count==0){
     cout<<-1<<endl;
 }
 else{
     cout<<-2<<endl;
 }
}
